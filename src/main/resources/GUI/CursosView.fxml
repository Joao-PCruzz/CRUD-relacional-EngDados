<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="600.0" prefWidth="950.0" spacing="20.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.CursosController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>

        <VBox spacing="5.0">
            <children>
                <Label text="Gestão de Cursos" textFill="#3b5998">
                    <font>
                        <Font name="System Bold" size="22.0" />
                    </font>
                </Label>
                <Label text="Gerencie a estrutura dos cursos, turnos, níveis e campi da instituição" textFill="#777777">
                    <font>
                        <Font name="System Italic" size="13.0" />
                    </font>
                </Label>
            </children>
        </VBox>

        <HBox spacing="20.0" VBox.vgrow="ALWAYS">
            <children>

                <VBox minWidth="280.0" prefWidth="320.0" spacing="15.0" style="-fx-background-color: #f9f9f9; -fx-border-color: #dddddd; -fx-border-radius: 5; -fx-background-radius: 5;">
                    <padding>
                        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                    </padding>
                    <children>
                        <Label text="Informações do Curso" textFill="#333333">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Label>

                        <VBox spacing="5.0">
                            <children>
                                <Label text="ID do Curso" textFill="#555555" />
                                <TextField fx:id="txtIdCurso" prefHeight="30.0" promptText="Código numérico" />
                            </children>
                        </VBox>

                        <VBox spacing="5.0">
                            <children>
                                <Label text="Nome do Curso" textFill="#555555" />
                                <TextField fx:id="txtNomeCurso" prefHeight="30.0" promptText="Ex: Ciência da Computação" />
                            </children>
                        </VBox>

                        <VBox spacing="5.0">
                            <children>
                                <Label text="Grau" textFill="#555555" />
                                <ComboBox fx:id="cbGrau" maxWidth="1.7976931348623157E308" prefHeight="30.0" prefWidth="290.0" promptText="Selecione o grau..." />
                            </children>
                        </VBox>

                        <VBox spacing="5.0">
                            <children>
                                <Label text="Turno" textFill="#555555" />
                                <ComboBox fx:id="cbTurno" maxWidth="1.7976931348623157E308" prefHeight="30.0" prefWidth="290.0" promptText="Selecione o turno..." />
                            </children>
                        </VBox>

                        <VBox spacing="5.0">
                            <children>
                                <Label text="Campus" textFill="#555555" />
                                <TextField fx:id="txtCampus" prefHeight="30.0" promptText="Ex: São Cristóvão" />
                            </children>
                        </VBox>

                        <VBox spacing="5.0">
                            <children>
                                <Label text="Nível" textFill="#555555" />
                                <ComboBox fx:id="cbNivel" maxWidth="1.7976931348623157E308" prefHeight="30.0" prefWidth="290.0" promptText="Selecione o nível..." />
                            </children>
                        </VBox>

                        <Region VBox.vgrow="ALWAYS" />

                        <HBox alignment="CENTER_RIGHT" spacing="10.0">
                            <children>
                                <Button fx:id="btnSalvar" mnemonicParsing="false" onAction="#handleSalvarCurso" prefHeight="30.0" prefWidth="90.0" style="-fx-background-color: #5cb85c; -fx-text-fill: white;" text="Salvar">
                                    <font>
                                        <Font name="System Bold" size="12.0" />
                                    </font>
                                </Button>
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <TextField fx:id="txtPesquisa" prefHeight="30.0" promptText="Pesquise pelo ID do curso..." HBox.hgrow="ALWAYS" />
                                <Button fx:id="btnPesquisar" mnemonicParsing="false" onAction="#handlePesquisarCurso" prefHeight="30.0" prefWidth="100.0" style="-fx-background-color: #3b5998; -fx-text-fill: white;" text="Pesquisar" />
                            </children>
                        </HBox>

                        <TableView fx:id="tvCursos" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colIdCurso" prefWidth="70.0" text="ID" />
                                <TableColumn fx:id="colNomeCurso" prefWidth="200.0" text="Nome" />
                                <TableColumn fx:id="colGrau" prefWidth="110.0" text="Grau" />
                                <TableColumn fx:id="colTurno" prefWidth="100.0" text="Turno" />
                                <TableColumn fx:id="colCampus" prefWidth="130.0" text="Campus" />
                                <TableColumn fx:id="colNivel" prefWidth="110.0" text="Nível" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>

                        <HBox alignment="CENTER_RIGHT" spacing="10.0">
                            <children>
                                <Button fx:id="btnAtualizar" mnemonicParsing="false" onAction="#handleAtualizarCurso" prefHeight="30.0" prefWidth="100.0" style="-fx-background-color: #4b6cb7; -fx-text-fill: white;" text="Atualizar" />
                                <Button fx:id="btnDeletar" mnemonicParsing="false" onAction="#handleDeletarCurso" prefHeight="30.0" prefWidth="100.0" style="-fx-background-color: #d9534f; -fx-text-fill: white;" text="Deletar" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </HBox>
    </children>
</VBox>
