<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="600.0" prefWidth="1000.0" spacing="20.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.VinculosController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>

        <VBox spacing="5.0">
            <children>
                <Label text="Gestão de Vínculos Académicos" textFill="#3b5998">
                    <font>
                        <Font name="System Bold" size="22.0" />
                    </font>
                </Label>
                <Label text="Matricule estudantes em cursos e controle o histórico de status de ingressos e saídas" textFill="#777777">
                    <font>
                        <Font name="System Italic" size="13.0" />
                    </font>
                </Label>
            </children>
        </VBox>

        <HBox spacing="20.0" VBox.vgrow="ALWAYS">
            <children>

                <VBox minWidth="290.0" prefWidth="330.0" spacing="12.0" style="-fx-background-color: #f9f9f9; -fx-border-color: #dddddd; -fx-border-radius: 5; -fx-background-radius: 5;">
                    <padding>
                        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                    </padding>
                    <children>
                        <Label text="Informações do Vínculo" textFill="#333333">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Label>

                        <VBox spacing="4.0">
                            <children>
                                <Label text="ID do Vínculo" textFill="#555555" />
                                <TextField fx:id="txtIdVinculo" prefHeight="30.0" promptText="Código numérico autogerado" />
                            </children>
                        </VBox>

                        <VBox spacing="4.0">
                            <children>
                                <Label text="Estudante" textFill="#555555" />
                                <ComboBox fx:id="cbEstudante" maxWidth="1.1797693134862315E308" prefHeight="30.0" promptText="Selecione o estudante..." />
                            </children>
                        </VBox>

                        <VBox spacing="4.0">
                            <children>
                                <Label text="Curso" textFill="#555555" />
                                <ComboBox fx:id="cbCurso" maxWidth="1.1797693134862315E308" prefHeight="30.0" promptText="Selecione o curso..." />
                            </children>
                        </VBox>

                        <VBox spacing="4.0">
                            <children>
                                <Label text="Data de Entrada" textFill="#555555" />
                                <DatePicker fx:id="dpDataEntrada" maxWidth="1.1797693134862315E308" prefHeight="30.0" promptText="dd/mm/aaaa" />
                            </children>
                        </VBox>

                        <VBox spacing="4.0">
                            <children>
                                <Label text="Status do Vínculo" textFill="#555555" />
                                <ComboBox fx:id="cbStatus" maxWidth="1.1797693134862315E308" prefHeight="30.0" promptText="Selecione o status..." />
                            </children>
                        </VBox>

                        <VBox spacing="4.0">
                            <children>
                                <Label text="Data de Saída (Opcional)" textFill="#555555" />
                                <DatePicker fx:id="dpDataSaida" maxWidth="1.1797693134862315E308" prefHeight="30.0" promptText="dd/mm/aaaa" />
                            </children>
                        </VBox>

                        <Region VBox.vgrow="ALWAYS" />

                        <HBox alignment="CENTER_RIGHT" spacing="10.0">
                            <children>
                                <Button fx:id="btnSalvar" mnemonicParsing="false" onAction="#handleSalvarVinculo" prefHeight="30.0" prefWidth="90.0" style="-fx-background-color: #5cb85c; -fx-text-fill: white;" text="Salvar">
                                    <font>
                                        <Font name="System Bold" size="12.0" />
                                    </font>
                                </Button>
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <TextField fx:id="txtPesquisa" prefHeight="30.0" promptText="Pesquise pelo ID do vínculo..." HBox.hgrow="ALWAYS" />
                                <Button fx:id="btnPesquisar" mnemonicParsing="false" onAction="#handlePesquisarVinculo" prefHeight="30.0" prefWidth="100.0" style="-fx-background-color: #3b5998; -fx-text-fill: white;" text="Pesquisar" />
                            </children>
                        </HBox>

                        <TableView fx:id="tvVinculos" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colIdVinculo" prefWidth="70.0" text="ID Vínculo" />
                                <TableColumn fx:id="colEstudante" prefWidth="150.0" text="Estudante (Matrícula)" />
                                <TableColumn fx:id="colCurso" prefWidth="150.0" text="Curso (ID)" />
                                <TableColumn fx:id="colDataEntrada" prefWidth="120.0" text="Data Entrada" />
                                <TableColumn fx:id="colStatus" prefWidth="110.0" text="Status" />
                                <TableColumn fx:id="colDataSaida" prefWidth="120.0" text="Data Saída" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>

                        <HBox alignment="CENTER_RIGHT" spacing="10.0">
                            <children>
                                <Button fx:id="btnAtualizar" mnemonicParsing="false" onAction="#handleAtualizarVinculo" prefHeight="30.0" prefWidth="100.0" style="-fx-background-color: #4b6cb7; -fx-text-fill: white;" text="Atualizar" />
                                <Button fx:id="btnDeletar" mnemonicParsing="false" onAction="#handleDeletarVinculo" prefHeight="30.0" prefWidth="100.0" style="-fx-background-color: #d9534f; -fx-text-fill: white;" text="Deletar" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </HBox>
    </children>
</VBox>