<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="600.0" prefWidth="900.0" spacing="20.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.EstudantesController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>

        <VBox spacing="5.0">
            <children>
                <Label text="Gestão de Estudantes" textFill="#3b5998">
                    <font>
                        <Font name="System Bold" size="22.0" />
                    </font>
                </Label>
                <Label text="Gerencie as matrículas e dados acadêmicos dos alunos" textFill="#777777">
                    <font>
                        <Font name="System Italic" size="13.0" />
                    </font>
                </Label>
            </children>
        </VBox>

        <HBox spacing="20.0" VBox.vgrow="ALWAYS">
            <children>

                <VBox minWidth="280.0" prefWidth="320.0" spacing="15.0" style="-fx-background-color: #f9f9f9; -fx-border-color: #dddddd; -fx-border-radius: 5; -fx-background-radius: 5;">
                    <padding>
                        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                    </padding>
                    <children>
                        <Label text="Informações do Estudante" textFill="#333333">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Label>

                        <VBox spacing="5.0">
                            <children>
                                <Label text="Matrícula" textFill="#555555" />
                                <TextField fx:id="txtMatricula" prefHeight="30.0" />
                            </children>
                        </VBox>

                        <VBox spacing="5.0">
                            <children>
                                <Label text="Média Curricular (MC)" textFill="#555555" />
                                <TextField fx:id="txtMc" prefHeight="30.0" />
                            </children>
                        </VBox>

                        <VBox spacing="5.0">
                            <children>
                                <Label text="Ano de Ingresso" textFill="#555555" />
                                <TextField fx:id="txtAnoIngresso" prefHeight="30.0" />
                            </children>
                        </VBox>

                        <VBox spacing="5.0">
                            <children>
                                <Label text="Usuário Associado" textFill="#555555" />
                                <ComboBox fx:id="cbUsuario" maxWidth="1.1797693134862315E308" prefHeight="30.0" promptText="Selecione o usuário..." />
                            </children>
                        </VBox>

                        <Region VBox.vgrow="ALWAYS" />

                        <HBox alignment="CENTER_RIGHT" spacing="10.0">
                            <children>
                                <Button fx:id="btnSalvar" mnemonicParsing="false" onAction="#handleSalvarEstudante" prefHeight="30.0" prefWidth="90.0" style="-fx-background-color: #5cb85c; -fx-text-fill: white;" text="Salvar">
                                    <font>
                                        <Font name="System Bold" size="12.0" />
                                    </font></Button>
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                    <children>
                        <HBox spacing="10.0" alignment="CENTER_LEFT">
                            <children>
                                <TextField fx:id="txtPesquisa" prefHeight="30.0" promptText="Pesquise por matrícula..." HBox.hgrow="ALWAYS" />
                                <Button fx:id="btnPesquisar" mnemonicParsing="false" onAction="#handlePesquisarEstudante" prefHeight="30.0" prefWidth="100.0" style="-fx-background-color: #3b5998; -fx-text-fill: white;" text="Pesquisar" />
                            </children>
                        </HBox>

                        <TableView fx:id="tvEstudantes" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colMatricula" prefWidth="130.0" text="Matrícula" />
                                <TableColumn fx:id="colMc" prefWidth="80.0" text="MC" />
                                <TableColumn fx:id="colAnoIngresso" prefWidth="110.0" text="Ano Ingresso" />
                                <TableColumn fx:id="colUsuario" prefWidth="180.0" text="Usuário Relacionado" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>

                        <HBox alignment="CENTER_RIGHT" spacing="10.0">
                            <children>
                                <Button fx:id="btnAtualizar" mnemonicParsing="false" onAction="#handleAtualizarEstudante" prefHeight="30.0" prefWidth="100.0" style="-fx-background-color: #4b6cb7; -fx-text-fill: white;" text="Atualizar" />
                                <Button fx:id="btnDeletar" mnemonicParsing="false" onAction="#handleDeletarEstudante" prefHeight="30.0" prefWidth="100.0" style="-fx-background-color: #d9534f; -fx-text-fill: white;" text="Deletar" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </HBox>
    </children>
</VBox>